<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:ads="http://schemas.android.com/apk/lib/com.google.ads"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_option"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/title_current_home"
            android:textAppearance="?android:attr/textAppearanceLargeInverse"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/home_app"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dip">

        <ImageView
            android:id="@+id/home_app_icon"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="5dip"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/home_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_toRightOf="@+id/home_app_icon"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/home_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/home_app_name"
            android:layout_marginLeft="5dip"
            android:layout_toRightOf="@+id/home_app_icon"/>

    </RelativeLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="3dip"
        android:layout_marginTop="5dip"
        android:background="#000000"/>

    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dip"
        android:layout_marginRight="5dip"
        android:text="@string/msg_user_guide"
        android:textColor="#0000FF"
        android:textSize="16dip"/>

    <!--
    <TextView
            android:id="@+id/display_loading"
            android:text="@string/loading"
            android:textSize="16dip"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="5dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
             -->

    <!--  -->
    <View
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:layout_marginBottom="3dip"
        android:background="#000000"/>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="fill_parent">

        <RelativeLayout
            android:id="@+id/process_area"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="invisible">

            <ProgressBar
                android:id="@+id/progressBar1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/process_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/progressBar1"
                android:text="@string/loading"
                android:textSize="36dip"/>
        </RelativeLayout>

        <ListView
            android:id="@+id/list_all_apps"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"/>

    </RelativeLayout>

</LinearLayout>
